section.after-gallery#gallery(aria-labelledby="after-gallery-title")
  .after-container
    .after-section-heading
      .after-botanical(aria-hidden="true")
        span ❧
        span ♥
        span ❧
      h2#after-gallery-title Фотографии со свадьбы
      p Немного тёплых кадров с нашего дня — от церемонии до самого уютного вечера.
    .after-gallery__grid
      figure.after-gallery-card.after-gallery-card--ceremony
        .after-gallery-card__image
          img(src="./images/after-wedding/gallery/gallery-ceremony.webp" alt="Молодожёны на церемонии у цветочной арки" width="1672" height="941" loading="lazy")
        figcaption Церемония
      figure.after-gallery-card.after-gallery-card--walk
        .after-gallery-card__image
          img(src="./images/after-wedding/gallery/gallery-walk.webp" alt="Прогулка молодожёнов по набережной Петербурга" width="1448" height="1086" loading="lazy")
        figcaption Прогулка
      figure.after-gallery-card
        .after-gallery-card__image
          img(src="./images/after-wedding/gallery/gallery-guests.webp" alt="Молодожёны и гости поднимают бокалы за праздничным столом" width="1448" height="1086" loading="lazy")
        figcaption Гости
      figure.after-gallery-card
        .after-gallery-card__image
          img(src="./images/after-wedding/gallery/gallery-details.webp" alt="Букет, обручальные кольца и свадебная лента" width="1448" height="1086" loading="lazy")
        figcaption Детали
      figure.after-gallery-card
        .after-gallery-card__image
          img(src="./images/after-wedding/gallery/gallery-evening.webp" alt="Уютный вечер молодожёнов в ресторане" width="1448" height="1086" loading="lazy")
        figcaption Вечер

